# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional risk-based captcha verification
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Client IP for rate limits (adapter-node). Prefer the platform header; do not
# trust X-Forwarded-For unless a reverse proxy overwrites it.
# Behind Cloudflare:
# ADDRESS_HEADER=CF-Connecting-IP
# Behind another proxy that appends X-Forwarded-For:
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
